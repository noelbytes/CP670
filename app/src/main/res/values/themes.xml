<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AndroidAssignments" parent="Theme.Material3.DayNight">
        <!-- Customize your theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.AndroidAssignments" parent="Base.Theme.AndroidAssignments" />

    <style name="Theme.AndroidAssignments.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Custom Button Style with all attributes -->
    <style name="CustomButtonStyle" parent="Widget.Material3.Button">
        <!-- Height -->
        <item name="android:layout_height">48dp</item>

        <!-- Padding -->
        <item name="android:padding">12dp</item>

        <!-- Margins -->
        <item name="android:layout_margin">8dp</item>

        <!-- Font Size -->
        <item name="android:textSize">16sp</item>

        <!-- Font Color -->
        <item name="android:textColor">@color/white</item>

        <!-- Background Color for Material3 -->
        <item name="backgroundTint">@color/material_green</item>

        <!-- Additional attributes for better button appearance -->
        <item name="android:textAllCaps">false</item>
    </style>

</resources>